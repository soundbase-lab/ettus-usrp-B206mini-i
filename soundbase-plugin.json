{
  "manifestVersion": 1,
  "id": "ettus-usrp-b206mini-i",
  "name": "Ettus USRP B206mini-i",
  "version": "0.4.2",
  "license": "BUSL-1.1",
  "platforms": [
    "darwin-arm64",
    "darwin-x64"
  ],
  "repository": "https://github.com/soundbase-lab/ettus-usrp-B206mini-i",
  "maintainers": [
    {
      "name": "Matt Dale",
      "email": "matt.dale@soundbase.app"
    }
  ],
  "contract": {
    "core": "1.4",
    "modules": {
      "SpectrumAnalyzer": "1.2"
    }
  },
  "runtime": {
    "type": "node",
    "entrypoint": "main.js"
  },
  "deployment": [
    "managed"
  ],
  "template": {
    "name": "soundbase-plugin-template",
    "version": "1.0.11"
  },
  "products": [
    {
      "deviceTypeId": "plugin:ettus-usrp-b206mini-i/b206mini-i",
      "manufacturer": {
        "id": "ettus-research",
        "name": "Ettus Research"
      },
      "model": {
        "id": "b206mini-i",
        "name": "B206mini-i",
        "displayName": "USRP B206mini-i"
      },
      "family": {
        "id": "usrp-b200",
        "name": "USRP B200 series"
      },
      "capabilities": {
        "spectrumAnalyzer": true
      },
      "traits": {
        "isSpectrumAnalyzer": true
      }
    }
  ],
  "pluginConfigFields": [
    {
      "id": "engineNote",
      "type": "static-text",
      "label": "Sweep engine",
      "help": "Built on this machine the first time the plugin runs. Needs cmake and UHD 4.9 or newer:\n\n```sh\nbrew install cmake ninja uhd\n```"
    },
    {
      "id": "enginePath",
      "type": "textinput",
      "label": "Engine binary",
      "default": "",
      "help": "Leave blank to use the built-in engine."
    },
    {
      "id": "levelOffsetDb",
      "type": "number",
      "label": "Level offset",
      "default": 0,
      "help": "Added to every amplitude, in dB. Corrects for feeder loss or a preamp."
    }
  ],
  "deviceConfigFields": [
    {
      "id": "serial",
      "type": "textinput",
      "label": "Serial number",
      "default": "",
      "help": "Leave blank when only one radio is attached."
    }
  ],
  "stateKeys": []
}
